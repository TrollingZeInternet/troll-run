generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model ScanLog {
  id           String   @id @default(cuid())
  address      String
  network      String
  symbol       String?
  name         String?
  score        Int?
  riskLevel    String?
  timestamp    DateTime @default(now())
  source       String   @default("web") // "web" | "telegram" | "api"
  chatId       String?
  responseTime Int?     // in ms
  cached       Boolean  @default(false)
  error        String?

  @@index([address])
  @@index([timestamp])
  @@index([symbol])
  @@index([source])
  @@index([network])
  @@index([address, timestamp])
}
